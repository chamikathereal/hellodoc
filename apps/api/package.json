{
  "name": "@hellodoc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prebuild": "prisma generate",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test ./test/unit/identifiers.test.ts ./test/unit/password-policy.test.ts ./test/unit/session-rules.test.ts ./test/unit/patient-phone.test.ts ./test/unit/appointment-rules.test.ts ./test/unit/queue-state.test.ts ./test/unit/notification-render.test.ts ./test/unit/payload-crypto.test.ts ./test/unit/fake-sms.provider.test.ts ./test/unit/smslenz-send.test.ts ./test/unit/sms-gateway-enqueue.test.ts ./test/unit/money-totp.test.ts ./test/unit/production-config.test.ts ./test/unit/clinic-account-email.test.ts",
    "backup:check": "node --env-file=.env scripts/restore-check.mjs",
    "inventory:classify": "node --env-file=.env scripts/classify-local-inventory.mjs",
    "mfa:check": "node --env-file=.env scripts/mfa-enforcement-check.mjs",
    "test:integration": "node --env-file=.env --import tsx --test ./test/integration/phase1-flow.test.ts ./test/integration/saas-flow.test.ts ./test/integration/patients-flow.test.ts ./test/integration/appointments-flow.test.ts ./test/integration/queue-flow.test.ts ./test/integration/notifications-flow.test.ts ./test/integration/two-clinic-http.test.ts ./test/integration/clinical-flow.test.ts ./test/integration/billing-flow.test.ts ./test/integration/clinical-access.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name phase1_platform",
    "prisma:deploy": "prisma migrate deploy",
    "poc:isolation": "node --env-file=.env scripts/poc-schema-isolation.mjs",
    "create-platform-admin": "node --env-file=.env scripts/create-platform-admin.mjs",
    "tenants:migrate": "node --env-file=.env scripts/migrate-tenant-schemas.mjs",
    "tenants:rename-schemas": "node --env-file=.env scripts/rename-tenant-schemas.mjs",
    "tenants:backfill-tracking-index": "node --env-file=.env scripts/backfill-tracking-token-index.mjs",
    "catalogs:seed": "node --env-file=.env scripts/seed-catalogs.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
